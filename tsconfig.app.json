{
  "extends": "@vue/tsconfig/tsconfig.dom.json",

  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "incremental": true,
    "noUnusedParameters": true,
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}